# ============================================================
# Configuracion Rockbar Jukebox
# Copia este archivo como ".env" y completa los valores reales
# ============================================================

# Carpeta donde estan los videos de las canciones (ruta completa de Windows)
# Ejemplo: C:\Musica\VideosBar
VIDEOS_FOLDER=C:\Musica\VideosBar

# Extensiones de video a listar (separadas por coma)
VIDEO_EXTENSIONS=.mp4,.avi,.mkv,.mov,.wmv,.flv,.webm,.m4v

# Puerto donde correra ESTA app web (la que ven los clientes en el celular)
PORT=3000

# URL publica de esta app dentro de la red del bar, usada para generar el QR.
# Poner la IP LOCAL de la PC (ver instrucciones en el README, comando "ipconfig").
# Ejemplo: http://192.168.1.50:3000
PUBLIC_URL=http://192.168.1.50:3000

# --- Conexion con VirtualDJ (Network Control Plugin) ---
# Configuralo en VirtualDJ: Config -> Extensions -> Effects -> Other -> "Network Control"
# Ahi mismo se define el puerto y (opcional) una contrasena/bearer token.
VDJ_HOST=127.0.0.1
VDJ_PORT=8093
VDJ_BEARER=

# Plantilla del script VDJscript usado para seleccionar y agregar la cancion.
# {folder} y {query} se reemplazan automaticamente.
#
# Los pasos van separados por "||": cada uno se manda a VirtualDJ por
# separado, con una pausa real (VDJ_STEP_DELAY_MS) entre cada uno. Esto es
# necesario porque VDJscript no tiene forma de "esperar" dentro de un mismo
# comando, y si todo se manda junto, VirtualDJ puede agregar al Automix
# la cancion que haya quedado seleccionada de ANTES, no la pedida.
#
# IMPORTANTE: probar esto en vivo contra el VirtualDJ real y ajustar si hace
# falta (ver seccion "Probar y ajustar la integracion" en el README).
VDJ_SELECT_SCRIPT=browser_gotofolder "{folder}" || search "{query}" || playlist_add & search ""

# Pausa (en milisegundos) entre cada paso de arriba. Si notas que sigue
# agregando la cancion equivocada, subi este numero (por ejemplo a 700 u 800).
VDJ_STEP_DELAY_MS=400

# Minutos que una cancion recien agregada por la app se muestra SIEMPRE
# como "En lista", sin importar lo que diga la consulta en vivo al Automix
# durante ese rato. Blindaje para que el boton no vuelva a "Agregar" de
# golpe a los pocos segundos. Poné un numero mayor a la duracion tipica de
# tus videos.
AUTOMIX_RECENT_GRACE_MINUTES=10

# --- Limite anti-abuso: ventana rodante ---
# Cuantos pedidos "gratis" puede hacer UN mismo dispositivo/celular dentro
# de la ventana de tiempo de abajo. Por defecto: 2 pedidos cada 120 minutos
# (2 horas), y se va renovando solo con el tiempo (no hace falta esperar a
# que termine la noche). Los creditos ganados (ver mas abajo) permiten pedir
# canciones EXTRA aunque no haya cupo libre en la ventana.
REQUESTS_PER_WINDOW=2
REQUEST_WINDOW_MINUTES=120

# Hora (0-23) en que se considera que "empieza" una noche nueva. Todos los
# contadores (pedidos, creditos, nombre guardado) se reinician a esta hora.
# Ej: 6 significa que se reinicia todos los dias a las 6:00 AM (para que una
# noche de bar que pasa la medianoche cuente como una sola noche).
NIGHT_RESET_HOUR=6

# --- Nombre del usuario ---
# Si es "true", no se puede pedir ninguna cancion sin haber puesto un
# nombre/apodo primero (se pide en la pantalla de bienvenida). Se usa para
# identificar los pedidos en el panel del DJ.
NICKNAME_REQUIRED=true

# --- Creditos extra: Instagram y juego ---
# Cuantos creditos se ganan por seguir la cuenta de Instagram del bar (una
# sola vez por noche) y por cada partida del juego, y cada cuanto se puede
# volver a jugar (para que no se puedan juntar creditos infinitos).
CREDITS_PER_INSTAGRAM=1
CREDITS_PER_GAME=1
GAME_COOLDOWN_MINUTES=30

# Usuario y link de Instagram del bar, para el boton "Seguir" de la pantalla
# de bienvenida. IMPORTANTE: la app NO puede verificar de verdad si alguien
# te sigue (Instagram no lo permite sin una integracion oficial con revision
# de Meta) — el credito se otorga "a confianza" apenas tocan el boton.
INSTAGRAM_HANDLE=@barracudabar
INSTAGRAM_URL=https://instagram.com/barracudabar

# --- Panel de administracion (para el DJ/encargado) ---
# Token simple para entrar a /admin y ver/resetear los contadores. Cambialo.
ADMIN_TOKEN=cambiar-esta-clave

# Nombre del bar, se muestra en la pagina
BAR_NAME=Rock Bar
